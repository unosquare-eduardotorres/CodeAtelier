{
  "name": "code-atelier",
  "version": "1.0.0",
  "description": "Code Atelier — Where Craft Meets Code",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:restart": "pkill -f 'electron-vite' 2>/dev/null; pkill -f 'Electron' 2>/dev/null; sleep 1 && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "npx electron-builder install-app-deps && npx patch-package",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "bash scripts/build-mac.sh",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test:unit": "tsx src/main/services/__tests__/run-tests.ts",
    "test:repo": "tsx src/main/db/repositories/__tests__/run-tests.ts",
    "test:all": "npm run test:unit && npm run test:repo",
    "test:cov": "c8 node --import tsx --enable-source-maps src/main/__tests__/run-all.ts",
    "test:cov:html": "c8 --reporter=html --reporter=text node --import tsx --enable-source-maps src/main/__tests__/run-all.ts",
    "test:cov:check": "c8 --check-coverage --lines 30 --functions 30 --branches 25 node --import tsx --enable-source-maps src/main/__tests__/run-all.ts",
    "check:sdk": "npm outdated @anthropic-ai/claude-agent-sdk || true"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^12.8.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "jsdom": "^29.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/fuses": "^2.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/eb-garamond": "^5.2.7",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "^1.59.0-alpha-2026-03-27",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.19.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.27",
    "c8": "^10.1.3",
    "electron": "^40.8.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.13.0",
    "officeparser": "^6.0.4",
    "patch-package": "^8.0.1",
    "playwright": "^1.59.0-alpha-2026-03-27",
    "playwright-core": "^1.59.0-alpha-2026-03-27",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.8",
    "prettier": "^3.7.4",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.1",
    "react-diff-viewer-continued": "^4.2.0",
    "react-dom": "^19.2.1",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "react-simple-code-editor": "^0.14.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "repomap-mcp": "^0.1.1",
    "simple-git": "^3.33.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "ws": "^8.20.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  }
}
