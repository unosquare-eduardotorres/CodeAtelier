{
  "name": "code-atelier",
  "version": "1.0.19",
  "description": "Code Atelier — Where Craft Meets Code",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:restart": "pkill -f 'electron-vite' 2>/dev/null; pkill -f 'Electron' 2>/dev/null; sleep 1 && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "npx electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "bash scripts/build-mac.sh",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test:unit": "tsx src/main/services/__tests__/run-tests.ts",
    "test:repo": "tsx src/main/db/repositories/__tests__/run-tests.ts",
    "test:all": "npm run test:unit && npm run test:repo",
    "test:cov": "c8 node --import tsx --enable-source-maps src/main/__tests__/run-all.ts",
    "test:cov:html": "c8 --reporter=html --reporter=text node --import tsx --enable-source-maps src/main/__tests__/run-all.ts",
    "test:cov:check": "c8 --check-coverage --lines 33 --functions 50 --branches 75 node --import tsx --enable-source-maps src/main/__tests__/run-all.ts",
    "test:cov:full": "bash scripts/coverage-full.sh"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@iconify-json/lucide": "^1.2.117",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/sdk": "^1.15.3",
    "better-sqlite3": "^12.11.1",
    "d3-force": "^3.0.0",
    "echarts": "^6.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "jsdom": "^29.0.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "react-force-graph-2d": "^1.29.1",
    "repomap-mcp": "^0.1.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/fuses": "^2.1.2",
    "@electron/rebuild": "^4.0.4",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/eb-garamond": "^5.2.7",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-virtual": "^3.14.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-force": "^3.0.10",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.19.19",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "c8": "^11.0.0",
    "canvas": "^3.2.3",
    "electron": "^42.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.13.0",
    "playwright": "^1.61.1",
    "playwright-core": "^1.61.1",
    "prettier": "^3.7.4",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.1",
    "react-diff-viewer-continued": "^4.2.0",
    "react-dom": "^19.2.1",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "react-simple-code-editor": "^0.14.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.33.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "ws": "^8.20.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "hono": "^4.12.25",
    "js-yaml": "^4.2.0",
    "undici": "^7.28.0"
  }
}
