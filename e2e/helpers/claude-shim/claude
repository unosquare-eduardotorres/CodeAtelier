/**
 * BUILD — one response per task session. The build service spawns a fresh
 * session per task, so each process sees exactly one kickoff message with the
 * task context embedded. The completion block claims no files: the shim does
 * not write anything, and a claim the disk check would refute (missing files)
 * forces gaps_found. An empty claim with no planned files is honest.
 */
function buildBuildResponse(content) {
  // Extract the task id from the kickoff message when present (T001-style).
  const taskIdMatch = content.match(/\b(T\d{3}|R\d{3})\b/)
  const taskId = taskIdMatch ? taskIdMatch[1] : 'T001'
  return `Task ${taskId} implemented.

\`\`\`blueprint-phase-complete
{"phase":"build","status":"complete","taskId":"${taskId}","filesCreated":[],"filesModified":[]}
\`\`\``
}

