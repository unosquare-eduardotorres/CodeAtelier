// ── Slow chat (workspace-switch streaming tests) ──

/** A chat prompt containing this marker gets a deliberately slow stream. */
const SLOW_STREAM_MARKER = 'E2E_SLOW_STREAM'
/** Emitted in the last delta — proves the tail of the stream survived. */
const SLOW_STREAM_SENTINEL = 'E2E-STREAM-SENTINEL'
const SLOW_STREAM_DELTAS = Number(process.env.CLAUDE_SHIM_SLOW_DELTAS || 30)
const SLOW_STREAM_DELAY_MS = Number(process.env.CLAUDE_SHIM_SLOW_DELAY_MS || 1000)

const sleep = (ms) => new Promise((r) => setTimeout(r, ms))

/** Append a truncated copy of each user turn — makes shim-gated E2E failures diagnosable. */
function recordTurn(turn, content) {
  try {
    fs.appendFileSync(
      path.join(markerDir, `${spawnId}.turns.log`),
      `--- turn ${turn} ---\n${content.slice(0, 400)}\n`
    )
  } catch {
    /* ignore */
  }
}

/**
 * Drip a plain-text answer out over SLOW_STREAM_DELTAS × SLOW_STREAM_DELAY_MS.
 * The window is what makes "switch workspaces mid-stream" testable at all.
 */
async function handleSlowChatTurn() {
  emitMessageStart()
  emitTextBlockStart()

  let full = ''
  for (let i = 1; i <= SLOW_STREAM_DELTAS; i++) {
    const piece = i === SLOW_STREAM_DELTAS ? `${SLOW_STREAM_SENTINEL}\n` : `slow chunk ${i}\n`
    full += piece
    emitDelta(piece)
    await sleep(SLOW_STREAM_DELAY_MS)
  }

  emitResult(full)
}

// ── Phase detection ──

/**
 * Detect the pipeline phase from a kickoff message. Ordered most-specific
 * first: the whole-diff reviewers and the verifier all mention the diff or
 * verification, so their markers must be checked before the generic ones.
 */
function detectPhase(content) {
  // Lead-review pass: whole-diff review AFTER verify passed.
  if (
    content.includes('Lead review of the complete feature diff') ||
    (content.includes('lead reviewer') && content.includes('FEATURE DIFF'))
  ) {
    return 'lead-review'
  }
  // Code-review: external-reviewer stance over the whole diff.
  if (content.includes('Review the complete diff of this feature as an external reviewer')) {
    return 'code-review'
  }
  // Verify: adversarial verification kickoff.
  if (content.includes('Begin adversarial verification of the BUILD phase output')) {
    return 'verify'
  }
  // Build: per-task kickoff.
  if (content.includes('Implement the task described in "Current Task" above')) {
    return 'build'
  }
  // Review: pre-build artifact review.
  if (content.includes('Perform a comprehensive review of the blueprint artifacts')) {
    return 'review'
  }
  // Tasks: decomposition kickoff.
  if (content.includes('Decompose the implementation plan into wave-ordered')) {
    return 'tasks'
  }
  // Plan: planning kickoff.
  if (content.includes('Create a detailed implementation plan from the specification')) {
    return 'plan'
  }
  // Clarify: gap analysis kickoff.
  if (content.includes('Analyze the specification') || content.includes('gap analysis')) {
    return 'clarify'
  }
  // Specify: spec generation kickoff.
  if (
    content.includes('Generate a detailed specification') ||
    (content.includes('specification') && content.includes('description'))
  ) {
    return 'specify'
  }
  return null
}

// ── State machine ──

let turnCount = 0
let phase = null // null until detected; 'slow-chat' for the slow stream
let isSlowChat = false

// ── Main loop ──

async function main() {
  // 1. Emit system/init immediately
  emitInit()

  // 2. Read stdin line-by-line (NDJSON protocol)
  const rl = readline.createInterface({
    input: process.stdin,
    terminal: false,
    crlfDelay: Infinity
  })

  for await (const line of rl) {
    const trimmed = line.trim()
    if (!trimmed) continue

    let msg
    try {
      msg = JSON.parse(trimmed)
    } catch {
      // Not JSON — might be a slash command (ignore)
      continue
    }

    // Only process user messages
    if (msg.type !== 'user') continue

    const content = extractUserText(msg)
    turnCount++
    recordTurn(turnCount, content)

    // Slow-chat is detected on ANY turn: the app may send a preamble user
    // message before the operator's actual prompt, so gating this on turn 1
    // would silently fall through to the specify default.
    if (content.includes(SLOW_STREAM_MARKER)) {
      isSlowChat = true
    }

    // Phase detection on first user message
    if (turnCount === 1 && !isSlowChat) {
      phase = detectPhase(content)
      if (!phase) {
        // Default: treat as specify for robustness (legacy behaviour)
        phase = 'specify'
      }
    }

    // Route to the appropriate handler
    if (isSlowChat) {
      await handleSlowChatTurn()
      break // One slow turn is all the test needs
    } else if (phase === 'clarify') {
      handleClarifyTurn(content, turnCount)
      if (turnCount >= 2) break // Second turn completes clarify
    } else if (phase === 'build') {
      respond(buildBuildResponse(content))
      break // One task per session
    } else if (phase === 'plan') {
      respond(PLAN_RESPONSE)
      break
    } else if (phase === 'tasks') {
      respond(process.env.CLAUDE_SHIM_DAG_TASKS === '1' ? TASKS_DAG_RESPONSE : TASKS_RESPONSE)
      break
    } else if (phase === 'review') {
      respond(REVIEW_RESPONSE)
      break
    } else if (phase === 'verify') {
      respond(VERIFY_RESPONSE)
      break
    } else if (phase === 'code-review') {
      respond(CODE_REVIEW_RESPONSE)
      break
    } else if (phase === 'lead-review') {
      respond(LEAD_REVIEW_RESPONSE)
      break
    } else {
      // specify (default)
      handleSpecifyTurn(content)
      break // Specify is one-shot
    }
  }

  // Give a moment for stdout to flush, then exit cleanly
  await new Promise((r) => setTimeout(r, 100))
  process.exit(0)
}

function extractUserText(msg) {
  const message = msg.message
  if (!message || !message.content) return ''
  if (typeof message.content === 'string') return message.content
  if (Array.isArray(message.content)) {
    return message.content
      .filter((b) => b.type === 'text')
      .map((b) => b.text)
      .join('\n')
  }
  return ''
}

function handleSpecifyTurn(_content) {
  respond(SPECIFY_RESPONSE)
}

function handleClarifyTurn(content, turn) {
  if (turn === 1) {
    // First turn: emit findings + questions
    respond(buildClarifyTurn1Response())
  } else {
    // Second turn: user answered → check for sentinel or regression
    //
    // Bug 1 regression detection: if the incoming message is the phase kickoff
    // message again (contains "Analyze the specification") instead of actual answers,
    // the original bug is reintroduced. Re-emit identical questions so the test's
    // "zero duplicate clarifyQuestions events" assertion catches it.
    if (content.includes('Analyze the specification')) {
      // Regression! Re-emit questions (loop signature)
      respond(buildClarifyTurn1Response())
    } else {
      // Normal answer flow — emit resolved findings + completion
      respond(buildClarifyTurn2Response())
    }
  }
}

main().catch((err) => {
  process.stderr.write(`[claude-shim] Fatal error: ${err.message}\n`)
  process.exit(1)
})
