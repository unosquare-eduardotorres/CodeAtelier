#!/usr/bin/env node
/**
 * Fake `claude` CLI shim for E2E tests — speaks the NDJSON stream-json protocol.
 *
 * Conditional oracle: detects the phase from the first stdin user message and
 * emits the appropriate structured blocks.
 *
 * Specify session  → minimal spec + blueprint-phase-complete (specify)
 * Clarify turn 1   → findings + questions (q1–q3 with options)
 * Clarify turn 2   → reads answer, emits resolved findings + blueprint-phase-complete (clarify)
 * Plan session     → blueprint-plan block + gate-commands + blueprint-phase-complete (plan)
 * Tasks session    → blueprint-tasks block (waves format) + blueprint-phase-complete (tasks)
 * Review session   → blueprint-phase-complete (review, recommendation proceed)
 * Build session    → blueprint-phase-complete (build) per task
 * Verify session   → blueprint-phase-complete (verify, overallStatus passed)
 * Code-review      → blueprint-phase-complete (code-review, verdict approve, no findings)
 * Lead-review pass → blueprint-review-findings block (verdict approved, no findings)
 * Slow chat        → plain chat turn dripped out over ~15s (E2E_SLOW_STREAM marker),
 *                    so a test can act while the stream is still live
 *
 * Designed to be placed on PATH ahead of the real `claude` CLI.
 *
 * Protocol reference: src/main/services/cli-executor/ndjson-parser.ts
 *                     src/main/services/executor-utils/stream-normalizer.ts
 */

'use strict'

const fs = require('fs')
const path = require('path')
const readline = require('readline')

// ── Marker file (test can assert shim was used, not real CLI) ──

const markerDir = process.env.CLAUDE_SHIM_MARKER_DIR || path.join(__dirname, '.markers')
try {
  fs.mkdirSync(markerDir, { recursive: true })
} catch {
  /* ignore */
}
const spawnId = `shim-${Date.now()}-${process.pid}`
fs.writeFileSync(
  path.join(markerDir, spawnId),
  JSON.stringify({
    pid: process.pid,
    args: process.argv.slice(2),
    timestamp: new Date().toISOString()
  })
)

// ── NDJSON helpers ──

function emit(obj) {
  process.stdout.write(JSON.stringify(obj) + '\n')
}

function emitInit() {
  emit({
    type: 'system',
    subtype: 'init',
    session_id: `e2e-shim-${Date.now()}`,
    mcp_servers: []
  })
}

function emitTextBlockStart() {
  emit({
    type: 'stream_event',
    event: {
      type: 'content_block_start',
      content_block: { type: 'text' }
    }
  })
}

function emitDelta(text) {
  emit({
    type: 'stream_event',
    event: {
      type: 'content_block_delta',
      delta: { type: 'text_delta', text }
    }
  })
}

function emitTextDelta(text) {
  emitTextBlockStart()
  // Emit in one chunk for simplicity
  emitDelta(text)
}

function emitMessageStart() {
  emit({
    type: 'stream_event',
    event: {
      type: 'message_start',
      message: {
        usage: {
          input_tokens: 100,
          output_tokens: 0,
          cache_read_input_tokens: 0,
          cache_creation_input_tokens: 0
        }
      }
    }
  })
}

function emitResult(resultText) {
  emit({
    type: 'result',
    subtype: 'success',
    result: resultText || '',
    terminal_reason: 'end_turn',
    session_title: 'E2E Shim Session',
    usage: {
      input_tokens: 200,
      output_tokens: 100,
      cache_read_input_tokens: 0,
      cache_creation_input_tokens: 0
    }
  })
}

/** Emit a full response (message start + text + result) and exit the turn. */
function respond(text) {
  emitMessageStart()
  emitTextDelta(text)
  emitResult(text)
}

